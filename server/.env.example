# DaCy server configuration. Copy to server/.env (loaded automatically at startup;
# variables already set in the shell win). Every key is optional: without keys the
# server still runs URL inspection and the family relay, and reports the missing
# capabilities in GET /health.

# ---- HTTP ----
# Port to listen on (binds 0.0.0.0 so phones on the same Wi-Fi can reach it).
PORT=8787
# Requests per minute per client IP before 429 RATE_LIMITED.
RATE_LIMIT_PER_MIN=120
# Set to 0 to silence the per-request log line (method, path, status, ms).
DACY_LOG_REQUESTS=1

# ---- Claude (indicator extraction for text, call transcripts and screenshots) ----
# Enables capabilities.llm and capabilities.vision.
ANTHROPIC_API_KEY=
# Model id (default claude-opus-5-5).
DACY_LLM_MODEL=claude-opus-5-5
# Effort: low | medium | high | xhigh | max (default low — fast enough for live calls).
DACY_LLM_EFFORT=low

# ---- Speech-to-text (OpenAI-compatible /audio/transcriptions) ----
# openai | groq. Default: openai when OPENAI_API_KEY is set, else groq when GROQ_API_KEY is set.
STT_PROVIDER=
# Default model: gpt-4o-mini-transcribe (openai) / whisper-large-v3-turbo (groq).
STT_MODEL=
# Groq key (STT only).
GROQ_API_KEY=

# ---- OpenAI (speech-to-text and text-to-speech) ----
# Enables TTS (spoken warnings) and, unless STT_PROVIDER=groq, speech-to-text.
OPENAI_API_KEY=
# TTS model and voice for /v1/tts (mp3).
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ---- Storage ----
# Folder for family.json (family relay metadata only). Default: server/data
DACY_DATA_DIR=
